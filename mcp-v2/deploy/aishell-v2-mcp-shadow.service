[Unit]
Description=aishell v2 MCP/OAuth shadow server (localhost only, isolated staging)
After=network.target aishell-v2-stage.service
Requires=aishell-v2-stage.service

[Service]
Type=simple
User=aishell-mcp-test
Group=aishell-mcp-test
WorkingDirectory=/opt/aishell-v2
Environment=AISHELL_V2_OAUTH_DB=/var/lib/aishell-v2-stage/oauth.sqlite3
Environment=AISHELL_V2_EXECUTOR_SOCKET=/run/aishell-v2-stage/control.sock
Environment=AISHELL_V2_AUTH_USERS=/etc/aishell-v2/stage-auth-users.json
ExecStart=/opt/aishell-v2/.venv/bin/uvicorn mcp_shadow:app --host 127.0.0.1 --port 8767 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aishell-v2-stage
ReadOnlyPaths=/etc/aishell-v2/stage-auth-users.json
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=200M

[Install]
WantedBy=multi-user.target
